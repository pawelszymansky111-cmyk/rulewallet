{
  "name": "rulewallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:fmt": "cd contracts && forge fmt --check",
    "contracts:test": "cd contracts && forge test",
    "contracts:test:mainnet-fork": "cd contracts && RH_MAINNET_RPC_URL=${RH_MAINNET_RPC_URL:-https://rpc.mainnet.chain.robinhood.com} forge test --match-contract RobinhoodMainnetForkTest -vv",
    "contracts:artifact:generate": "node scripts/generate-contract-artifacts.mjs",
    "mainnet:prepare-deployment": "node scripts/prepare-mainnet-deployment.mjs",
    "contracts:artifact:check": "node scripts/check-contract-artifact.mjs",
    "signer:test": "node --test services/aws-kms-signer/handler.node-test.mjs",
    "links:check": "node scripts/check-internal-links.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run signer:test && npm run links:check && npm run contracts:fmt && npm run contracts:test && npm run contracts:test:mainnet-fork && npm run contracts:artifact:check && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-kms": "^3.1090.0",
    "@openzeppelin/contracts": "5.6.1",
    "@privy-io/react-auth": "^3.17.0",
    "@tanstack/react-query": "5.101.2",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "2.55.2",
    "wagmi": "3.7.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  }
}

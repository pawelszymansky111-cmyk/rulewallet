NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_RULEWALLET_TESTNET_ADDRESS=
# V3 command-center deployments. These must pass exact runtime and helper verification.
NEXT_PUBLIC_RULEWALLET_TESTNET_V3_FACTORY_ADDRESS=
NEXT_PUBLIC_RULEWALLET_TESTNET_STABLECOIN_ADDRESS=
NEXT_PUBLIC_RULEWALLET_MAINNET_V3_FACTORY_ADDRESS=
# Legacy V2 variables remain read-only compatibility inputs for older receipts.
NEXT_PUBLIC_RULEWALLET_MAINNET_FACTORY_ADDRESS=
NEXT_PUBLIC_RULEWALLET_MAINNET_ACCOUNT_ADDRESS=
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_MAINNET=true
RH_TESTNET_RPC_URL=
RH_TESTNET_RPC_FALLBACK_URL=
RH_MAINNET_RPC_URL=
RH_MAINNET_RPC_FALLBACK_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace aliases supported by the same storage adapter:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Testnet legacy signer only. Never used by the mainnet execution path.
AGENT_PRIVATE_KEY=
CRON_SECRET=
# Requires an actually configured scheduler; Hobby deployments leave this unset.
MAINNET_SCHEDULER_MODE=
ENABLE_MAINNET=true
ENABLE_MAINNET_AUTONOMY=false
MAINNET_SIGNER_MODE=disabled
MAINNET_AGENT_ADDRESS=
MAINNET_SIGNER_ENDPOINT=
# Store endpoint credentials only in the secure runtime/KMS integration.
MAINNET_SIGNER_AUTH_TOKEN=
MAINNET_SIGNER_ALLOWED_HOST=
MAINNET_SIGNER_KEY_ID=
# sha256:<64 lowercase hex characters> supplied by the real KMS/MPC/HSM service.
MAINNET_SIGNER_ATTESTATION_SHA256=
MAINNET_STRATEGY_ENCRYPTION_KEY=
# 32-byte hex secret for short-lived, wallet-signed private commerce sessions.
COMMERCE_SESSION_SECRET=
# Required hard ceilings for any future autonomous release; no defaults are assumed.
MAINNET_MAX_GAS=
MAINNET_MAX_FEE_PER_GAS_WEI=
MAINNET_MAX_PRIORITY_FEE_PER_GAS_WEI=
MAINNET_ALERT_WEBHOOK_URL=
MAINNET_ALERT_WEBHOOK_TOKEN=
# Optional authenticated HTTPS delivery for testnet execution, approval,
# failure, and unusual-spending events. Route this to email, Telegram,
# Slack, or an incident platform without exposing its token to the browser.
TESTNET_NOTIFICATION_WEBHOOK_URL=
TESTNET_NOTIFICATION_WEBHOOK_TOKEN=
# Optional provider integrations. Keep secrets server-side in Vercel.
DUFFEL_ACCESS_TOKEN=
TICKETMASTER_API_KEY=
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
